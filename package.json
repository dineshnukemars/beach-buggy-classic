{
  "name": "browser-game-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "tools/*",
    "games/*"
  ],
  "scripts": {
    "dev": "npm run dev:game",
    "dev:game": "npm run dev -w @studio/beach-buggy",
    "dev:gltf": "npm run dev -w @studio/gltf-preview",
    "dev:texture": "npm run dev -w @studio/texture-preview",
    "dev:anim": "npm run dev -w @studio/animation-preview",
    "dev:scene": "npm run dev -w @studio/scene-editor",
    "test": "npm test --workspaces --if-present",
    "test:pipeline": "npm run smoke -w @studio/pipeline-smoke"
  },
  "devDependencies": {
    "typescript": "~5.8.3"
  }
}
